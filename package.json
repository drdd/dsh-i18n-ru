{
  "name": "dsh-i18n-ru",
  "version": "1.0.0",
  "description": "Русская локализация интерфейса DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib", "locale", "cordis.patch.yml", "icon.svg"],
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.5" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-locale"],
      "immediately": true
    }
  }
}
